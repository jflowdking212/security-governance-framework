# Copy this file to .uss-version in a consuming project.
# Replace every placeholder with values from the independently verified release.
version=1.0.0
tag=v1.0.0
commit=<40-character signed release commit SHA>
sha256sums_sha256=<64-character SHA-256 digest of SHA256SUMS>
signing_fingerprint=SHA256:zfXCAflnGbD1984rV8kabaPj92UyXIs0gCVsIspIX/o
bundles_sha256sums_sha256=<64-character SHA-256 digest of the signed bundle SHA256SUMS, if using bundles>
profile_path=<optional relative path to the consuming project's security profile>
profile_sha256=<64-character SHA-256 digest of that profile, if present>
